#include <iostream>
#include <string>
#include <Windows.h>
using namespace std;

int main()
{
    SetConsoleCP(1251);
    SetConsoleOutputCP(1251);

    int choice;
    cout << "Выберите задание (1, 2, 3 или 4): ";
    cin >> choice;

    if (choice == 1)
    {
        cout << "---------ЗАДАНИЕ 1----------" "\n";
        int i = 0;

        while (true)
        {
            cout << i << " ";
            i++;

            if (i > 10)
                i = 0;
        }
    }
    else if (choice == 2)
    {
        cout << "---------ЗАДАНИЕ 2----------" "\n";
        string text;
        cout << "Введите строку: ";
        cin >> text;

        for (int j = 0; j < text.length(); j++)
        {
            cout << text[j] << "л" << text[j];
        }

        cout << "\n";
    }
    else if (choice == 3)
    {
        cout << "---------ЗАДАНИЕ 3----------" "\n";
        int length, width;
        cout << "Введите длину: ";
        cin >> length;
        cout << "Введите ширину: ";
        cin >> width;

        int number = 1;

        for (int i = 0; i < length; i++)
        {
            for (int j = 0; j < width; j++)
            {
                cout << number << "\t";
                number++;
            }
            cout << "\n";
        }
    }
    else if (choice == 4)
    {
        cout << "---------ЗАДАНИЕ 4----------" "\n";

        for (int number = 1; number <= 10000; number++)
        {
            int count = 0;

            for (int divisor = 1; divisor < number; divisor++)
            {
                if (number % divisor == 0)
                    count++;
            }

            if (count >= 3)
                cout << number << " ";
        }

        cout << "\n";
    }
    else
    {
        cout << "Некорректный выбор";
    }

    return 0;
}
