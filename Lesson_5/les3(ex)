#include <iostream>
#include <string>
#include <Windows.h>
using namespace std;

int main()
{
    SetConsoleCP(1251);
    SetConsoleOutputCP(1251);

    cout << "--------------------------ЗАДАНИЕ 1----------------------------------" "\n";

    {
        int n;
        cout << "Введите четырехзначное число: ";
        cin >> n;

        int a = n % 10;
        int b = n / 10 % 10;
        int c = n / 100 % 10;
        int d = n / 1000;

        int result = a * 1000 + b * 100 + c * 10 + d;

        cout << "Перевернутое число: " << result << endl;
    }

    cout << "--------------------------ЗАДАНИЕ 2----------------------------------" "\n";

    {
        int n;
        cout << "Введите четырехзначное число: ";
        cin >> n;

        int a = n % 10;
        int b = n / 10 % 10;
        int c = n / 100 % 10;
        int d = n / 1000;

        int result = a * b * c * d;

        cout << "Произведение цифр: " << result << endl;
    }

    cout << "--------------------------ЗАДАНИЕ 3----------------------------------" "\n";

    {
        int sum = 0;

        for (int i = 1; i < 6; i++)
        {
            for (int j = 1; j < i; j++)
            {
                sum += i * j;
                cout << "i = " << i
                     << ", j = " << j
                     << ", sum = " << sum << endl;
            }
        }

        cout << "Итоговая сумма: " << sum << endl;
    }

    return 0;
}